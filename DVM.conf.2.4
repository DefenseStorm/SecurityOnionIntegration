filter {
    if [event][module] == "suricata"  or [event][module] == "zeek" {
      clone {
        clones => ["dvm"]
        add_tag => ["dvm"]
      }
   }
}
filter {
    if "dvm" in [tags] {
    if [event][module] == "zeek"{
      json {
        source => "message"
        target => "jsonMessage"
      }
      mutate {
          add_field => {
            "[jsonMessage][app_name]" => "%{[event][module]}"
            "[jsonMessage][category]" => "%{[pipeline]}"
          }
      }
    }
    if [event][module] == "suricata"{
      json {
        source => "message"
        target => "jsonMessage"
      }
      mutate {
          add_field => {
            "[jsonMessage][app_name]" => "%{[event][module]}"
          }
        }
      json {
        source => "message"
        remove_field => ["message"]
      }
      mutate {
        add_field => {
          "[jsonMessage][category]" => "%{[alert][category]}"
          }
        }
      }
    }
}

output {
  if "dvm" in [tags] {
    tcp  {
      id => "DVM"
        host => "DVM_IP"
        port => "516"
        codec => line {
          format => "%{jsonMessage}"
        }
      }
    }
  }
